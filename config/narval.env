# Space-separated environment modules. Replace SIESTA_MODULE after running
# slurm/00_diagnose.sh. Example only:
SIESTA_MODULES="StdEnv/2023 intel/2023.2.1 openmpi/4.1.5 siesta/5.4.0"

# Executable exposed by the selected module.
SIESTA_EXE="siesta"

# ASE substitutes PREFIX for the calculator label.
# srun inherits the task count requested by the current Slurm job.
ASE_SIESTA_COMMAND_TEMPLATE="srun --ntasks=\${SLURM_NTASKS:-1} ${SIESTA_EXE} < PREFIX.fdf > PREFIX.out"

SIESTA_PSEUDO_DIR="pseudopotentials"
SIESTA_PSEUDO_QUALIFIER=""

# Replace with the allocation shown by `account_config`.
SLURM_ACCOUNT="YOUR_ALLOCATION"
